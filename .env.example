# Copy to .env and fill in. Never commit the real .env.

# --- Basics ---------------------------------------------------------------
DEBUG=0
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DOMAIN=www.example.gr
ALLOWED_HOSTS=www.example.gr,example.gr
CSRF_TRUSTED_ORIGINS=https://www.example.gr,https://example.gr
SITE_URL=https://www.example.gr
# Admin address (keep it unguessable), must end with a slash
ADMIN_URL=manage-change-me/

# --- Email (needed for the automatic emails) -------------------------------
# Any SMTP provider works: your host's mailbox, Brevo, Mailgun, Postmark,
# Gmail/Google Workspace (with an app password)...
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=shop@example.gr
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Athos Icons <shop@example.gr>
# Where "new order" notifications go (can also be set in the admin → Shop settings)
SHOP_NOTIFY_EMAIL=you@example.gr

# --- Automatic parcel tracking (optional) -----------------------------------
# From your business contract with each courier. Fill in only the courier(s) you use.
# ACS: ask your ACS account manager for "ACS Web Services" access with rights to
# ACS_Trackingsummary and ACS_TrackingDetails (and give them the server's IP if they lock it).
ACS_API_KEY=
ACS_COMPANY_ID=
ACS_COMPANY_PASSWORD=
ACS_USER_ID=
ACS_USER_PASSWORD=
# Geniki Taxydromiki: user name, password and application key for the JobServicesV2 web service.
GENIKI_USERNAME=
GENIKI_PASSWORD=
GENIKI_APP_KEY=
# 1 while testing with the test user Geniki gives you (testvoucher.taxydromiki.gr)
GENIKI_TEST=0

# --- Bot protection (optional, recommended) ---------------------------------
# Free Cloudflare Turnstile keys: https://dash.cloudflare.com → Turnstile → Add widget
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Official ΑΦΜ check (optional, recommended) -------------------------------
# AADE "special codes" for Αναζήτηση Βασικών Στοιχείων Μητρώου Επιχειρήσεων (free, see README)
AADE_USERNAME=
AADE_PASSWORD=
