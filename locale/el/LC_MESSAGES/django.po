#: accounts/admin.py
msgid "Confirm email (e.g. customers you know or who called you)"
msgstr "Επιβεβαίωση email (π.χ. πελάτες που γνωρίζετε ή που σας τηλεφώνησαν)"

#: accounts/admin.py
msgid "The customer was emailed that business prices are now active."
msgstr ""
"Ο πελάτης ενημερώθηκε με email ότι οι τιμές επιχειρήσεων είναι ενεργές."

#: accounts/admin.py
#, python-format
msgid "%(n)s business account(s) approved."
msgstr "Εγκρίθηκαν %(n)s επαγγελματικοί λογαριασμοί."

#: accounts/admin.py
#, python-format
msgid "%(n)s account(s) can now order."
msgstr "%(n)s λογαριασμός(-οί) μπορούν πλέον να παραγγείλουν."

#: accounts/apps.py
msgid "Customers"
msgstr "Πελάτες"

#: accounts/decorators.py
msgid ""
"You are logged in with the shop's admin account, which cannot place orders. "
"Log out and use a customer account to try the shop."
msgstr ""
"Είστε συνδεδεμένοι με τον λογαριασμό διαχείρισης του καταστήματος, που δεν "
"μπορεί να κάνει παραγγελίες. Αποσυνδεθείτε και χρησιμοποιήστε έναν "
"λογαριασμό πελάτη για να δοκιμάσετε το κατάστημα."

#: accounts/forms.py
msgid "I accept the terms of use and the privacy policy"
msgstr "Αποδέχομαι τους όρους χρήσης και την πολιτική απορρήτου"

#: accounts/forms.py
msgid "Too many failed attempts. Please wait 15 minutes and try again."
msgstr ""
"Πάρα πολλές αποτυχημένες προσπάθειες. Περιμένετε 15 λεπτά και δοκιμάστε "
"ξανά."

#: accounts/forms.py
msgid "Required for Greek businesses."
msgstr "Υποχρεωτικό για ελληνικές επιχειρήσεις."

#: accounts/forms.py
msgid "An account with this email already exists. Try logging in."
msgstr "Υπάρχει ήδη λογαριασμός με αυτό το email. Δοκιμάστε να συνδεθείτε."

#: accounts/forms.py
msgid "To change your ΑΦΜ, please contact us."
msgstr "Για αλλαγή ΑΦΜ, επικοινωνήστε μαζί μας."

#: accounts/forms.py
msgid "Required for business accounts."
msgstr "Απαιτείται για επαγγελματικούς λογαριασμούς."

