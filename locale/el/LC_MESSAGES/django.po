msgid "%d product updated."
msgid_plural "%d products updated."
msgstr[0] "Ενημερώθηκε %d προϊόν."
msgstr[1] "Ενημερώθηκαν %d προϊόντα."

#: catalog/admin.py
#, python-format
msgid "Discount {}%%"
msgstr "Έκπτωση {}%%"

#: catalog/admin.py
msgid "Enter the price for this size."
msgstr "Συμπληρώστε την τιμή για αυτό το μέγεθος."

#: catalog/admin.py
msgid ""
"Leave this empty for icons with sizes: businesses pay each size's price "
"without VAT."
msgstr ""
"Αφήστε το κενό για εικόνες με μεγέθη: οι επιχειρήσεις πληρώνουν την τιμή "
"κάθε μεγέθους χωρίς ΦΠΑ."

#: catalog/admin.py
msgid "Enter the price incl. or excl. VAT."
msgstr "Συμπληρώστε την τιμή με ή χωρίς ΦΠΑ."

#: catalog/admin.py
msgid "incl. VAT (€)"
msgstr "με ΦΠΑ (€)"

